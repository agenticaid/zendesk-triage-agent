# Copy this file to .env and fill in the real values.
#
#   cp .env.example .env
#
# .env is gitignored. .env.example is committed, so anyone cloning this repo
# knows which variables the scripts need without ever seeing a real key.

# --- Anthropic ---
# https://platform.claude.com, Settings, API keys. Shown once.
# The API account needs credits separately from a Claude subscription.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Zendesk ---
# Subdomain is what appears before .zendesk.com in your URL.
ZENDESK_SUBDOMAIN=your-subdomain

# OAuth is the supported path. Zendesk stops accepting API tokens on
# 30 April 2027. Create a client in Admin Center > Apps and integrations >
# APIs > OAuth Clients, kind Confidential, redirect http://localhost:8080/callback
# then run: python3 scripts/zendesk_oauth.py
# Access tokens are short-lived (hours) and no refresh token is requested,
# so re-run this script whenever a live call starts returning 401 invalid_token.
ZENDESK_OAUTH_CLIENT_ID=triage_agent_local
ZENDESK_OAUTH_SECRET=your-client-secret
# Filled in automatically by scripts/zendesk_oauth.py:
# ZENDESK_OAUTH_TOKEN=

# Fallback only, used if no OAuth token is present.
# ZENDESK_EMAIL=you@example.com
# ZENDESK_API_TOKEN=

# --- Cloud Run service (main.py) ---
# Shared secret the Zendesk webhook must send back as the X-Webhook-Secret
# header, so /triage can't be called by anyone who finds the public URL.
# Generate with: openssl rand -hex 24
TRIAGE_WEBHOOK_SECRET=your-random-secret
